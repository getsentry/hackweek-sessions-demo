# Copy to .env.local and fill in your project's DSN.
# The app runs fine without one — the SDK just no-ops instead of sending.
NEXT_PUBLIC_SENTRY_DSN=https://daf4b07efc1caa1e80b19ca7a4f8deca@o447951.ingest.us.sentry.io/4511925508636672
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Server/edge runtimes fall back to NEXT_PUBLIC_SENTRY_DSN if this is unset.
SENTRY_DSN=https://daf4b07efc1caa1e80b19ca7a4f8deca@o447951.ingest.us.sentry.io/4511925508636672

# Build-time only: needed for source map upload. Leave blank for local dev.
SENTRY_ORG=sentry-sdks
SENTRY_PROJECT=hackweek-sessions-demo
SENTRY_AUTH_TOKEN=
